{
  "manifest_version": 3,
  "name": "抖音优化 - 跳过直播广告购物",
  "version": "3.3.0",
  "description": "智能跳过直播/广告/购物，支持弹窗设置总开关和子开关",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://douyin.com/*"
  ],
  "action": {
      "default_popup": "popup.html",
      "default_title": "抖音优化 - 设置"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://douyin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}

{
  "manifest_version": 3,
  "name": "抖音优化 - 跳过直播广告购物",
  "version": "3.0.0",
  "description": "参考油猴插件 V6.3.2，智能跳过直播/广告/购物内容，收缩检测区域防止误判",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://douyin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://douyin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
